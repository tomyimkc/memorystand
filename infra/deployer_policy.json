{
  "Comment": [
    "Least-privilege policy for the IAM user that DEPLOYS MemoryStand.",
    "",
    "Bedrock note: modern Claude models on Bedrock are INFERENCE_PROFILE-only, so a call",
    "targets a profile ARN in YOUR account rather than the bare foundation model. A",
    "cross-region profile then fans out to member regions, and each underlying foundation",
    "model must ALSO be permitted or the call is denied at the far end -- hence both ARN",
    "shapes below. Region is wildcarded on the foundation models; the model id is not.",
    "",
    "This is NOT the Lambda execution role -- that is infra/iam_policy.json and is narrower.",
    "Substitute ACCOUNT_ID before use."
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "LambdaFunctionLifecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PutFunctionConcurrency",
        "lambda:AddPermission",
        "lambda:CreateFunctionUrlConfig",
        "lambda:GetFunctionUrlConfig",
        "lambda:UpdateFunctionUrlConfig",
        "lambda:DeleteFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:memorystand",
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:memorystand-*"
      ]
    },
    {
      "Sid": "CreateTheLambdaExecutionRoleAndNothingElse",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/memorystand-lambda-role"
    },
    {
      "Sid": "PassOnlyThatRoleAndOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/memorystand-lambda-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "LogGroupWithRetention",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:ACCOUNT_ID:log-group:/aws/lambda/memorystand*"
    },
    {
      "Sid": "SecretsUnderOnePathOnly",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:DeleteParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:us-east-1:ACCOUNT_ID:parameter/memorystand/*"
    },
    {
      "Sid": "KmsForSecureStringOnly",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "ssm.us-east-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AmplifyStaticHosting",
      "Effect": "Allow",
      "Action": [
        "amplify:CreateApp",
        "amplify:GetApp",
        "amplify:ListApps",
        "amplify:CreateBranch",
        "amplify:GetBranch",
        "amplify:CreateDeployment",
        "amplify:StartDeployment",
        "amplify:GetJob",
        "amplify:DeleteApp"
      ],
      "Resource": "*"
    },
    {
      "Sid": "KeepWarmSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule",
        "events:CreateConnection",
        "events:DescribeConnection",
        "events:CreateApiDestination",
        "events:DescribeApiDestination",
        "events:UpdateApiDestination"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BedrockNamedModelsAndTheirInferenceProfiles",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:Converse"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1:ACCOUNT_ID:inference-profile/us.anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-haiku-4-5-20251001-v1:0",
        "arn:aws:bedrock:*::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "SeeWhichModelsAreAvailable",
      "Effect": "Allow",
      "Action": [
        "bedrock:ListFoundationModels",
        "bedrock:GetFoundationModelAvailability",
        "bedrock:ListInferenceProfiles",
        "bedrock:GetInferenceProfile"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WatchTheBill",
      "Effect": "Allow",
      "Action": [
        "budgets:DescribeBudgets",
        "budgets:ViewBudget",
        "ce:GetCostAndUsage",
        "servicequotas:GetServiceQuota",
        "servicequotas:ListServiceQuotas"
      ],
      "Resource": "*"
    }
  ]
}
